# English360 GPT - Environment Variables
#
# ⚠️ IMPORTANT: Never commit real API keys to Git!
#
# For Vercel/Cloudflare deployment:
# - Set these in the Vercel/Cloudflare dashboard
# - They are stored as build-time env vars
#
# For development/testing:
# - Copy this to .env.local
# - They will NOT be included in production builds

# AI Provider Configuration (for development only)
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4o-mini

# App Configuration
VITE_APP_TITLE=English360 GPT
VITE_APP_BASE_URL=/
